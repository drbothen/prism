        <!-- PRISM SATELLITE -->
        <mxCell id="satellite" value="&lt;b&gt;Prism Satellite&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:9px'&gt;[headless appliance at the edge]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Captures &amp;amp; translates on-site&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;Listens to your IT/OT network traffic&lt;br&gt;Connects to your existing tools&lt;br&gt;Normalizes everything to one&lt;br&gt;common format&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style='font-size:10px;color:#c62828'&gt;&lt;b&gt;Raw data stays here.&lt;/b&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1168BD;strokeColor=#0B4884;fontColor=#ffffff;arcSize=8;fontSize=11;" vertex="1" parent="zone_customer">
