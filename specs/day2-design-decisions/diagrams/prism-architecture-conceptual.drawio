        <mxCell id="zone_customer" value="Your environment  (your infrastructure / on-site)" style="swimlane;startSize=38;html=1;fontStyle=1;fontSize=13;fillColor=#f0f8e8;strokeColor=#82b366;strokeWidth=3;fontColor=#2d5016;verticalAlign=top;align=left;spacingLeft=14;" vertex="1" parent="1">
