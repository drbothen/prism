        <mxCell id="title" value="Prism  |  Conceptual Architecture  (C4 L1/L2)" style="text;html=1;align=center;fontStyle=1;fontSize=18;fontColor=#1a1a2e;" vertex="1" parent="1">
          <mxGeometry x="40" y="16" width="1520" height="32" as="geometry" />
        </mxCell>

        <!-- Subtitle / tagline -->
        <mxCell id="tagline" value="One unified view across IT and OT  |  Your data stays on your site  |  Your existing tools stay in place" style="text;html=1;align=center;fontSize=11;fontColor=#555555;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="40" y="48" width="1520" height="20" as="geometry" />
        </mxCell>

        <!-- ================================================= -->
