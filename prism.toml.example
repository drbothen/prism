# prism.toml.example — Prism v1.0.0-rc.1 configuration template
#
# Copy this file to prism.toml in your config directory.
# Place your config directory path in the PRISM_CONFIG_DIR environment variable,
# or pass it via `prism start --config-dir <path>`.
#
# QUICK START (extract → configure → run):
#   1. Extract the release archive; it contains this file plus the bundled
#      Claroty xDome sensor spec under specs/.
#   2. Decide where your config directory lives (e.g., /etc/prism/ or ~/prism/).
#   3. Copy this file there as prism.toml.
#   4. Copy the bundled specs/ directory to spec_dir (or set spec_dir to point at it).
#   5. Set state_dir to a writable path for RocksDB persistent state.
#   6. Add at least one [[orgs]] entry with a UUID v7 org_id and a kebab-case org_slug.
#   7. Configure credentials with `prism credential set` (see `prism credential --help`).
#   8. Run: prism start
#
# Note: enrichment infusion specs (ENRICH clause / ThreatIntel / NVD) ship with the
# separate demo bundle, not the plain binary archive.

# ---------------------------------------------------------------------------
# spec_dir (required)
# ---------------------------------------------------------------------------
# Path to the directory containing *.sensor.toml spec files.
# The Claroty xDome sensor spec is bundled in the release archive under specs/.
# Copy that directory to a permanent location and point spec_dir at it.
#
# Relative paths are resolved from the config directory (where prism.toml lives).
spec_dir = "./specs"

# ---------------------------------------------------------------------------
# state_dir (required)
# ---------------------------------------------------------------------------
# Path to the RocksDB persistent state directory.
# Prism creates this directory at boot if it does not exist.
# Must be writable by the prism process.
state_dir = "/var/lib/prism/state"

# ---------------------------------------------------------------------------
# plugin_dir (optional; default: "./plugins" relative to config directory)
# ---------------------------------------------------------------------------
# Path to the directory scanned for *.prx WASM plugin files.
# Place any WASM enrichment plugins here (e.g., threatintel-lookup.prx from the
# demo bundle). Omit or set PRISM_DISABLE_PLUGIN_LOAD=1 to skip plugin loading.
# plugin_dir = "./plugins"

# ---------------------------------------------------------------------------
# orgs (required; at least one entry)
# ---------------------------------------------------------------------------
# Each org entry maps an org_id (UUID v7) to an org_slug (kebab-case).
# org_id must be a UUID version 7 (time-ordered). Prism validates this at boot
# and exits 2 with "must be a UUID v7" if a non-v7 UUID is supplied.
#
# Note: plain `uuidgen` (no flags) generates UUID v4 — rejected.
#       `uuidgen --time` generates UUID v1 — also rejected.
#
# Generate a v7 UUID with one of:
#   Linux (util-linux 2.41+): uuidgen -7   (or: uuidgen --time-v7)
#   Python 3.14+:             python3 -c "import uuid; print(uuid.uuid7())"
#
# Multiple orgs are supported for multi-tenant deployments.

[[orgs]]
org_id = "REPLACE-WITH-UUID-V7"   # e.g. "0196f000-0000-7000-8000-000000000001"
org_slug = "my-org"               # kebab-case; used in audit logs and MCP context
# name = "My Organization"        # optional display name (surfaces in prism://config/clients)

# Add additional orgs below for multi-tenant deployments:
# [[orgs]]
# org_id = "REPLACE-WITH-ANOTHER-UUID-V7"
# org_slug = "second-org"

# ---------------------------------------------------------------------------
# credential_backend (optional; default: keyring)
# ---------------------------------------------------------------------------
# Controls where sensor API credentials are stored and retrieved.
# "keyring"        — OS keyring (macOS Keychain, Linux Secret Service, Windows Credential Manager)
# "encrypted_file" — Argon2id-encrypted file backend; requires a `path` field
#
# Default (OS keyring — recommended):
# [credential_backend]
# type = "keyring"
#
# Encrypted-file backend (useful in environments without an OS keyring):
# [credential_backend]
# type = "encrypted_file"
# path = "/etc/prism/credentials.bin"

# ---------------------------------------------------------------------------
# Infusion specs (auto-scanned; NOT included in the rc.1 plain binary archive)
# ---------------------------------------------------------------------------
# Enrichment infusion specs (threatintel.infusion.toml, nvd.infusion.toml) ship
# with the separate demo bundle (S-REL-004), not the plain binary archive.
# The threatintel infusion requires the threatintel-lookup.prx WASM plugin;
# the NVD infusion requires sensor data not present in the Claroty-only rc.1.
# When using the demo bundle: place infusions/ alongside this prism.toml file;
# it is auto-scanned from {config_dir}/infusions/ at boot (non-fatal if absent).
